{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plainbalance SQLite Prototype",
  "version": "0.3.1",
  "identifier": "com.talarurus.odaraia.sqlite-prototype",
  "build": {
    "beforeBuildCommand": "node build-web.mjs",
    "beforeDevCommand": "node build-web.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "plainbalance by Talarurus \u2014 Synthetic SQLite Prototype",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        "prototype"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Finance",
    "shortDescription": "Synthetic local SQLite compatibility prototype",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/plainbalance.icns"
    ]
  }
}
